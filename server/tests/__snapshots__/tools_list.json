      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Active incidents"
    },
    "description": "Use when the user asks what's going on, whether anything is wrong, or for a status overview of the household. Covers home hazards (weather warnings, air quality, nearby fires) and production on-call alerts. Returns the most severe active incidents, each with a short spoken summary and the single most important action to take.",
    "inputSchema": {
      "properties": {
        "limit": {
          "default": 3,
          "description": "Maximum incidents to return.",
          "maximum": 5,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "min_severity": {
          "default": "low",
          "description": "Only return incidents at or above this severity.",
          "enum": [
            "critical",
            "high",
            "moderate",
            "low"
          ],
          "title": "Min Severity",
          "type": "string"
        },
        "scope": {
          "default": "all",
          "description": "home = hazards, work = production on-call, all = both.",
          "enum": [
            "all",
            "home",
            "work"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
