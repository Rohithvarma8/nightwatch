                "low"
              ],
              "title": "Severity",
              "type": "string"
            },
            "spoken_summary": {
              "title": "Spoken Summary",
              "type": "string"
            },
            "started_at": {
              "title": "Started At",
              "type": "string"
            },
            "status": {
              "enum": [
                "open",
                "acknowledged",
                "escalated",
                "resolved"
              ],
              "title": "Status",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "top_action": {
              "title": "Top Action",
              "type": "string"
            }
