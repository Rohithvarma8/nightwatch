      "readOnlyHint": true,
      "title": "Explain an incident"
    },
    "description": "Use when the user asks why, how you know, what an alert means, or for more detail about an incident (for example 'why?', 'tell me more about the fire one', 'what's the wind thing'). Defaults to the top-ranked active incident. Pass `reference` with the user's own words to pick a different one. Returns what happened, what it means for the household, the evidence behind it, a confidence level, a timeline, and the sources.",
    "inputSchema": {
      "properties": {
        "depth": {
          "default": "brief",
          "description": "brief = top evidence only; full = all evidence + timeline.",
          "enum": [
            "brief",
            "full"
          ],
          "title": "Depth",
          "type": "string"
        },
        "incident_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact incident id from a previous result, if known.",
          "title": "Incident Id"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the user referred to it, e.g. 'the fire one' or 'the wind thing'. Matched against titles, alert types, and hazard types.",
          "title": "Reference"
        }
      },
      "title": "explain_incidentArguments",
      "type": "object"
    },
