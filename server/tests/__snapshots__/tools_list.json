              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Escalation Due At"
            },
            "evidence_preview": {
              "items": {
                "type": "string"
              },
              "title": "Evidence Preview",
              "type": "array"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "kind": {
              "enum": [
                "hazard",
                "prod"
              ],
              "title": "Kind",
              "type": "string"
            },
            "replay": {
              "title": "Replay",
              "type": "boolean"
            },
            "replay_original_time": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
